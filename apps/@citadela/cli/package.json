{
  "name": "@citadela/cli",
  "version": "0.1.0",
  "description": "Citadela command-line interface and terminal UI.",
  "type": "module",
  "bin": {
    "citadela": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@citadela/connector": "workspace:*",
    "@opentui/core": "^0.5.10",
    "@opentui/react": "^0.5.10",
    "react": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.29",
    "@types/react": "^19.1.6",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
